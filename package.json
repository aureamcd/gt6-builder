{
  "name": "gt6-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:human": "playwright test e2e/human-journey.spec.ts --headed --project=\"Desktop Chrome\"",
    "test:headed": "playwright test --headed --workers=1",
    "test:vercel": "playwright test --config playwright.vercel.config.ts",
    "test:vercel:headed": "playwright test --config playwright.vercel.config.ts --headed",
    "test:multiuser": "playwright test e2e/multi-user-sharing.spec.ts --headed --project=\"Desktop Chrome\"",
    "test:campos": "playwright test e2e/all-field-types-complete.spec.ts --project=\"Desktop Chrome\" --workers=1",
    "test:campos:headed": "playwright test e2e/all-field-types-complete.spec.ts --headed --project=\"Desktop Chrome\" --workers=1",
    "test:preview": "playwright test e2e/preview-complete.spec.ts --headed --project=\"Desktop Chrome\"",
    "test:tudo": "playwright test --headed --project=\"Desktop Chrome\" --workers=1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
